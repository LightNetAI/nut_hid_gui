{
  "$schema": "https://schema.tauri.app/config-2",
  "productName": "NUT HID Configurator",
  "version": "0.1.0",
  "identifier": "com.nut-hid.gui",
  "build": {
    "frontendDist": "./public",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "title": "NUT HID Configurator",
        "width": 1200,
        "height": 900,
        "minWidth": 900,
        "minHeight": 700,
        "resizable": true,
        "center": true,
        "decorations": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "windows": {
      "digestAlgorithm": "sha256"
    }
  }
}
